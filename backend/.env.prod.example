# ── SAGI: plantilla PROD (secretos solo en el servidor/gestor de secretos) ─
# En EC2 usa un .env con permisos 600 o inyecta estos valores con un gestor.
# No subas el .env real a git ni compartas sus valores.
# settings.py (DJANGO_ENV=prod) falla al arrancar si falta algo (fail-closed).
# Ver docs/entornos.md y docs/backups.md.

DJANGO_ENV=prod
SECRET_KEY=<COMPLETAR: secreto del PaaS, 50+ chars generados con get_random_secret_key>
MFA_ENCRYPTION_KEY=<COMPLETAR: llave Fernet del PaaS (NO reutilizar SECRET_KEY)>
DEBUG=False
ALLOWED_HOSTS=<COMPLETAR: api.tu-dominio.edu.co>

# DB prod: proyecto Supabase PROD, pooler (6543). Pass solo en secretos.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=<COMPLETAR: ej. postgres.xxxxxprod>
DB_PASSWORD=<COMPLETAR: secreto del PaaS>
DB_HOST=<COMPLETAR: ej. aws-1-us-east-1.pooler.supabase.com>
DB_PORT=6543

# Archivos: bucket privado de Supabase Storage del proyecto PROD.
# Obtén el endpoint, región y access keys en Storage > Configuration > S3.
# Las access keys S3 son server-side y tienen acceso amplio; no van en el frontend.
MEDIA_STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=<COMPLETAR: bucket privado de prod>
SUPABASE_S3_ENDPOINT_URL=<COMPLETAR: https://PROJECT_REF.storage.supabase.co/storage/v1/s3>
SUPABASE_S3_REGION=<COMPLETAR: región del proyecto PROD>
SUPABASE_S3_ACCESS_KEY_ID=<COMPLETAR: access key S3 server-side>
SUPABASE_S3_SECRET_ACCESS_KEY=<COMPLETAR: secret key S3 server-side>
# SUPABASE_STORAGE_PREFIX=media  # opcional, solo si todas las claves del bucket tienen ese prefijo

FRONTEND_URL=<COMPLETAR: https://tu-dominio.edu.co>
CORS_ALLOWED_ORIGINS=<COMPLETAR: https://tu-dominio.edu.co>
CSRF_TRUSTED_ORIGINS=<COMPLETAR: https://tu-dominio.edu.co>

LOG_LEVEL=WARNING
SENTRY_DSN=<COMPLETAR: DSN de prod en sentry.io>

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<COMPLETAR>
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<COMPLETAR>
EMAIL_HOST_PASSWORD=<COMPLETAR: secreto del PaaS>
DEFAULT_FROM_EMAIL=<COMPLETAR>
